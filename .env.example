REPLAY_MODE=true
MODEL_API_KEY=
SPARK_MAX_OUTPUT_TOKENS=12000
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=muse-glimmer
GLIMMER_MAX_TOKENS=3000
OPEN_TIER_LABEL=glimmer
# Optional Baseten Model API alternative (server-side only):
# GLIMMER_BASE_URL=https://inference.baseten.co/v1
# GLIMMER_API_KEY=<your Baseten API key>
# GLIMMER_MODEL=meta-models/muse-spark-open-1026
# OPEN_TIER_LABEL=spark-open
# Base URL/Bearer auth verified in Baseten docs; hackathon-specific model access is unverified.
DATA_DIR=data
# Native SAM uses frame/cost reservations; image fallback retains its own call-count cap.
SAM_MODE=image
# Bounded parallel image requests; use 1 for sequential execution.
SAM_IMAGE_WORKERS=3
# Five-minute Teach and native Check/validation; image tracking remains limited to 90 seconds.
MAX_RUN_DURATION_S=300
MAX_TEACHING_DURATION_S=300
MAX_VALIDATION_MASK_MB=192
# Free-tier worker: one expensive analysis at a time, across all accounts.
MAX_ACTIVE_JOBS=1
MAX_RUN_MASK_MB=128
# Conservative raw inline-video size below the documented 50 MB request limit.
SAM_VIDEO_MAX_BYTES=10485760
SAM_VIDEO_TIMEOUT_S=300
MAX_SAM_VIDEO_FRAMES=18000
HOSTED_MAX_SAM_VIDEO_FRAMES=18000
MAX_SAM_CALLS=3000
MAX_SPARK_CALLS=40
MAX_DAILY_SPARK_CALLS=60
MAX_RUN_COST_USD=8
MAX_DAILY_COST_USD=15
HOSTED_MAX_RUN_COST_USD=8
HOSTED_MAX_DAILY_COST_USD=15
MAX_UPLOAD_MB=100

AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only key authorizing durable budget reservations. Never use a VITE_ prefix.
SERVER_BUDGET_KEY=
CLOUD_JOBS=false
