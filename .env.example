DATA_DIR=data
MAX_SAM_CALLS=120
MAX_SPARK_CALLS=12
MAX_DAILY_SPARK_CALLS=60
MAX_RUN_COST_USD=2
MAX_UPLOAD_MB=100

AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only key authorizing durable budget reservations. Never use a VITE_ prefix.
SERVER_BUDGET_KEY=
CLOUD_JOBS=false
